POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_password
POSTGRES_DB=research_platform
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

DATABASE_URL=postgresql+psycopg2://research_user:research_password@localhost:5433/research_platform

# arXiv request pacing (persisted in api_request_states, shared across processes)
ARXIV_BASE_DELAY_SECONDS=5
ARXIV_JITTER_MAX_SECONDS=2
ARXIV_MAX_RETRIES=5
ARXIV_MAX_COOLDOWN_SECONDS=900
ARXIV_RATE_LIMIT_BASELINE_SECONDS=30
ARXIV_TEMPORARY_ERROR_BASELINE_SECONDS=10

# Historical backfill / quota ingestion
ARXIV_DEFAULT_PAGE_SIZE=200
BACKFILL_START_DATE=2016-01-01

# Semantic Scholar request pacing (persisted in api_request_states, shared across processes)
# SEMANTIC_SCHOLAR_API_KEY is a secret -- leave empty here, set the real value only in the
# git-ignored local .env file. Never commit a real key to this file.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_DELAY_SECONDS=1.1
SEMANTIC_SCHOLAR_MAX_RETRIES=5
SEMANTIC_SCHOLAR_429_BASELINE_SECONDS=30
SEMANTIC_SCHOLAR_MAX_COOLDOWN_SECONDS=900

# OpenAlex: required as of the 2026-07-29 budget-exhaustion incident --
# OpenAlex execution refuses to run without a key. OPENALEX_API_KEY is a
# secret -- leave empty here, set the real value only in the git-ignored
# local .env file. Never commit a real key to this file.
OPENALEX_API_KEY=

# Embedding model (paper-level embeddings / semantic search). None of these
# are secrets. EMBEDDING_MODEL_REVISION is pinned to the exact immutable
# Hugging Face commit sha for BAAI/bge-base-en-v1.5 -- do not change it to a
# mutable ref like "main" without deliberately re-pinning to a new sha.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
# Leave unset to use the code default (which has the required trailing
# space before the passage text). If overriding here, note that a trailing
# space on this line may be stripped by shells/tooling -- verify the loaded
# value if you do override it.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# LLM cluster labeling. ANTHROPIC_API_KEY is a secret -- leave empty here,
# set the real value only in the git-ignored local .env file. Never commit
# a real key to this file. The live API is not called until this key is set
# and a labeling run is explicitly executed.
ANTHROPIC_API_KEY=
CLUSTER_LABEL_PRIMARY_PROVIDER=anthropic
CLUSTER_LABEL_PRIMARY_MODEL=claude-haiku-4-5-20251001
CLUSTER_LABEL_FALLBACK_PROVIDER=anthropic
CLUSTER_LABEL_FALLBACK_MODEL=claude-sonnet-5
CLUSTER_LABEL_MAX_RETRIES=3
CLUSTER_LABEL_TIMEOUT_SECONDS=30
CLUSTER_LABEL_BASE_BACKOFF_SECONDS=2

# API / CORS. Comma-separated list of origins allowed to call the API
# cross-origin (e.g. the Vite frontend dev server). Never combined with
# credentialed requests -- see app.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173
